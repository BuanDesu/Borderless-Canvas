<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>BorderlessFlatWindow.App</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Private partial fixtures compile the single production source set, never a copied implementation. -->
    <Compile Include="../../src/BorderlessFlatWindow.App/**/*.cs" Exclude="../../src/BorderlessFlatWindow.App/**/bin/**;../../src/BorderlessFlatWindow.App/**/obj/**;../../src/BorderlessFlatWindow.App/Program.cs" Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/BorderlessFlatWindow.App/Assets/Borderless.ico;../../src/BorderlessFlatWindow.App/Assets/*.svg" LogicalName="BorderlessFlatWindow.App.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/BorderlessFlatWindow.App/Assets/Fonts/*.ttf" LogicalName="BorderlessFlatWindow.App.Assets.Fonts.%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/BorderlessFlatWindow.Presentation/BorderlessFlatWindow.Presentation.csproj" />
    <ProjectReference Include="../../src/BorderlessFlatWindow.Windows/BorderlessFlatWindow.Windows.csproj" />
    <ProjectReference Include="../../src/BorderlessFlatWindow.Recovery/BorderlessFlatWindow.Recovery.csproj" />
  </ItemGroup>
</Project>
