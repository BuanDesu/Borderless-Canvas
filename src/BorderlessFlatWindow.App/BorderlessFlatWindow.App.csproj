<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets/Borderless.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BorderlessFlatWindow.Presentation/BorderlessFlatWindow.Presentation.csproj" />
    <EmbeddedResource Include="Assets/Borderless.ico" />
    <EmbeddedResource Include="Assets/Fonts/*.ttf" />
    <EmbeddedResource Include="Assets/*.svg" />
    <Content Include="Assets/Licenses/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../BorderlessFlatWindow.Application/BorderlessFlatWindow.Application.csproj" />
    <ProjectReference Include="../BorderlessFlatWindow.Windows/BorderlessFlatWindow.Windows.csproj" />
  </ItemGroup>
</Project>
